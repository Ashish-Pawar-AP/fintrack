# development locally; production when deployed (enables Secure cookies, CSRF origin check, strict JWT_SECRET)
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/fintrack
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Production only: origin(s) the browser app is served from, if different from the API host
CLIENT_URL=
ALLOWED_ORIGINS=

# Password reset emails (optional locally: the link is printed to the console when SMTP_HOST is empty)
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
